# Пример конфигурации AI-тестировщика API
# Скопируйте в config.yaml и отредактируйте под свои нужды.
# Поддерживается подстановка переменных окружения: ${ИМЯ}
# Файл .env в текущей директории загружается автоматически.

# -------------------------------------------------------------
# Аутентификация для тестируемого API
# -------------------------------------------------------------
auth:
  # type: "none" | "bearer" | "api_key"
  type: none

  # Токен / API-ключ (можно вынести в .env через ${API_TOKEN})
  # token: "${API_TOKEN}"

  # Имя заголовка для type=api_key (по умолчанию X-API-Key)
  # header_name: "X-API-Key"

# -------------------------------------------------------------
# Параметры HTTP-клиента при выполнении тестов
# -------------------------------------------------------------
test_settings:
  timeout: 30.0                   # таймаут на один запрос, секунды
  delay_between_requests: 0.5     # пауза между тест-кейсами, секунды

# -------------------------------------------------------------
# Настройки LLM (GPTunnel)
# -------------------------------------------------------------
ai_settings:
  # Модель по умолчанию. Примеры доступных:
  #   gpt-4o, gpt-4o-mini, o1
  #   claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5
  #   gemini-2.5-pro, gemini-2.5-flash
  model: gpt-4o

  max_tokens: 16000               # макс. токенов в одном ответе LLM
  max_test_cases: 20              # макс. число генерируемых тестов
  include_negative_tests: true    # негативные тесты (невалидные данные)
  include_edge_cases: true        # граничные случаи

# -------------------------------------------------------------
# Цены моделей для калькулятора стоимости
# -------------------------------------------------------------
# В код встроены дефолты для популярных моделей (см. cost_estimator.py,
# DEFAULT_PRICES). Эта секция позволяет их переопределить или добавить
# новые модели, которых нет в дефолтах.
#
# Формат: рубли за 1 МИЛЛИОН токенов, раздельно вход и выход.
# Раскомментируйте нужные и подставьте актуальные цены вашего тарифа.
#
# pricing:
#   models:
#     gpt-4o:
#       input_per_1m: 220.0
#       output_per_1m: 880.0
#     gpt-4o-mini:
#       input_per_1m: 13.0
#       output_per_1m: 52.0
#     claude-opus-4-6:
#       input_per_1m: 1500.0
#       output_per_1m: 7500.0
#     claude-sonnet-4-6:
#       input_per_1m: 300.0
#       output_per_1m: 1500.0
#     # Добавьте свою модель, если её нет в дефолтах:
#     # my-custom-model:
#     #   input_per_1m: 100.0
#     #   output_per_1m: 400.0
